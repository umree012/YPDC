# Vercel automatically adds this when you connect a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Set a unique administrator password with at least 12 characters.
ADMIN_PASSWORD=
# Generate a random secret using the command in README.md (at least 32 characters).
SESSION_SECRET=
# Optional: false pauses new applications without disabling admin exports.
RECRUITMENT_OPEN=true
